@page "/projects"
@implements IDisposable
@inject ProjectsApiClient ProjectsApi

<PageTitle>Projects</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div>
        <h1 class="mb-1">Projects</h1>
        <p class="text-muted mb-0">Select a project to see its tasks.</p>
    </div>
    @if (projects is not null)
    {
        <span class="text-muted small">@projects.Count @(projects.Count == 1 ? "project" : "projects")</span>
    }
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2 text-muted" role="status" data-testid="projects-loading">
        <div class="spinner-border spinner-border-sm" aria-hidden="true"></div>
        <span>Loading projects…</span>
    </div>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger d-flex flex-wrap align-items-center justify-content-between gap-2" role="alert" data-testid="projects-error">
        <span>@errorMessage</span>
        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="LoadAsync">Try again</button>
    </div>
}
else if (projects is { Count: 0 })
{
    <div class="text-center text-muted border rounded p-5" data-testid="projects-empty">
        <p class="fs-5 mb-1">No projects yet</p>
        <p class="mb-0">Projects will appear here once they are created.</p>
    </div>
}
else if (projects is not null)
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3" data-testid="projects-list">
        @foreach (var project in projects)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h2 class="h5 card-title mb-0">@project.Name</h2>
                            <span class="badge rounded-pill text-bg-secondary flex-shrink-0">
                                @project.TaskCount @(project.TaskCount == 1 ? "task" : "tasks")
                            </span>
                        </div>

                        <p class="card-text @(string.IsNullOrWhiteSpace(project.Description) ? "text-muted fst-italic" : "")">
                            @(string.IsNullOrWhiteSpace(project.Description) ? "No description" : project.Description)
                        </p>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <small class="text-muted">Created @project.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy")</small>
                            @* stretched-link makes the whole card clickable. *@
                            <a href="projects/@project.Id/tasks" class="btn btn-sm btn-primary stretched-link"
                               aria-label="View tasks for @project.Name">View tasks</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private readonly CancellationTokenSource cts = new();
    private IReadOnlyList<ProjectSummary>? projects;
    private bool isLoading;
    private string? errorMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            projects = await ProjectsApi.GetProjectsAsync(cts.Token);
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ApiErrors.Describe(ex.StatusCode, "load projects");
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Navigated away while loading; nothing to show.
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}
