@page "/login"
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Sign in</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-sm-10 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Sign in to TaskTracker</h1>

                <EditForm Model="model" OnValidSubmit="SignInAsync">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label for="username" class="form-label">Username</label>
                        <InputText id="username" class="form-control" autocomplete="username" @bind-Value="model.Username" />
                        <ValidationMessage For="() => model.Username" />
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <InputText id="password" type="password" class="form-control" autocomplete="current-password" @bind-Value="model.Password" />
                        <ValidationMessage For="() => model.Password" />
                    </div>

                    @if (errorMessage is not null)
                    {
                        <div class="alert alert-danger py-2" role="alert">@errorMessage</div>
                    }

                    <button type="submit" class="btn btn-primary w-100" disabled="@isBusy">
                        @(isBusy ? "Signing in…" : "Sign in")
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly LoginModel model = new();
    private string? errorMessage;
    private bool isBusy;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(SafeReturnUrl, replace: true);
        }
    }

    private async Task SignInAsync()
    {
        isBusy = true;
        errorMessage = null;

        var result = await Auth.LoginAsync(model.Username, model.Password);

        isBusy = false;
        if (result.Succeeded)
        {
            Navigation.NavigateTo(SafeReturnUrl, replace: true);
        }
        else
        {
            errorMessage = result.ErrorMessage;
            model.Password = string.Empty;
        }
    }

    // Only allow local paths, so a crafted returnUrl can't redirect to another site.
    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl
            : "/";

    private sealed class LoginModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
